<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
   <title>Delete Assignment | Assignment Tracker</title>
    <!-- Bootstrap 5.3.9 via jsDelivr. Source: https://getbootstrap.com/docs/5.3/getting-started/introduction/ -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
  </head>
  <body>
  <%- include('partials/header') %>

<main class="container my-5 p-4 p-md-5 bg-light rounded-3 border">
  <h1>Delete Assignment</h1>
<p>Are you sure you want to delete <strong><%= assignment.title %></strong>?</p>

<form action="/assignments/<%= assignment._id %>/delete" method="POST">
  <button type="submit" class="btn btn-danger">Confirm Delete</button>
  <a href="/assignments" class="btn btn-outline-secondary">Cancel</a>
</form>
</main>

  <%- include('partials/footer') %>
</body>
</html>