<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
   <title>Edit Assignment | Assignment Tracker</title>
    <!-- Bootstrap 5.3.9 via jsDelivr. Source: https://getbootstrap.com/docs/5.3/getting-started/introduction/ -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
  </head>
  <body>
  <%- include('partials/header') %>

<main class="container my-5 p-4 p-md-5 bg-light rounded-3 border">
  <h1>Edit Assignment</h1>

<form action="/assignments/<%= assignment._id %>/edit" method="POST">
  <div class="mb-3">
    <label for="title" class="form-label">Title</label>
    <input id="title" name="title" type="text" class="form-control" value="<%= assignment.title %>" required>
  </div>

  <div class="mb-3">
    <label for="course" class="form-label">Course</label>
    <input id="course" name="course" type="text" class="form-control" value="<%= assignment.course %>" required>
  </div>

  <div class="mb-3">
    <label for="dueDate" class="form-label">Due date</label>
    <input id="dueDate" name="dueDate" type="date" class="form-control" value="<%= assignment.dueDate ? assignment.dueDate.toISOString().slice(0, 10) : '' %>" required>
  </div>

  <div class="mb-3">
    <label for="status" class="form-label">Status</label>
    <select id="status" name="status" class="form-select">
     <option value="To do" <%= assignment.status === 'To do' ? 'selected' : '' %>>To do</option>
<option value="In progress" <%= assignment.status === 'In progress' ? 'selected' : '' %>>In progress</option>
<option value="Done" <%= assignment.status === 'Done' ? 'selected' : '' %>>Done</option>
    </select>
  </div>

  <div class="mb-3">
    <label for="notes" class="form-label">Notes</label>
    <textarea id="notes" name="notes" class="form-control" rows="3"><%= assignment.notes || '' %></textarea>
  </div>

  <button type="submit" class="btn btn-primary">Save Changes</button>
  <a href="/assignments" class="btn btn-outline-secondary">Cancel</a>
</form>
</main>

  <%- include('partials/footer') %>
</body>
</html>